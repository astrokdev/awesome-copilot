---
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---
<div class="custom-site-title" style="display: flex; align-items: center; gap: 1rem;">
  <img src="/images/favicon.svg" alt="Schaeffler Logo" style="height: 32px;" />
  <div class="aura-logo-placeholder" style="height: 32px; padding: 0 8px; border: 1px dashed var(--sl-color-gray-3); border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; color: var(--sl-color-text-muted);">
    AURA logo
  </div>
  <Default><slot /></Default>
</div>
