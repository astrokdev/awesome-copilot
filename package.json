{
  "name": "aura-marketplace",
  "version": "1.0.0",
  "description": "Internal golden repo for embedded and automotive GitHub Copilot agents, instructions, and skills.",
  "main": "./eng/update-readme.js",
  "private": true,
  "scripts": {
    "start": "npm run build",
    "build": "node ./eng/update-readme.mjs && node ./eng/generate-marketplace.mjs && node ./eng/generate-badges.mjs",
    "plugin:validate": "node ./eng/validate-plugins.mjs",
    "plugin:create": "node ./eng/create-plugin.mjs",
    "skill:validate": "node ./eng/validate-skills.mjs",
    "skill:create": "node ./eng/create-skill.mjs",
    "agent:create": "node ./eng/create-agent.mjs",
    "instructions:create": "node ./eng/create-instructions.mjs",
    "plugin:clean": "node ./eng/clean-materialized-plugins.mjs",
    "plugin:generate-marketplace": "node ./eng/generate-marketplace.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.vitesco.io/SWProductivity/AURA_Marketplace.git"
  },
  "keywords": [
    "github",
    "copilot",
    "ai",
    "prompts",
    "instructions",
    "skills",
    "agents"
  ],
  "author": "GitHub",
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.1",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0"
  }
}
